1 'OX NET MATCH
10 CLS:?"OX NET MATCH"
20 S="https://ichigocrate-relay.ichigocrate-relay.workers.dev"
30 INPUT"ROOM 1-9999?",R:INPUT"PLAYER 1/2?",P
40 FOR I=0 TO 1:A=#1800+I*128:L=LEN(S):COPY A,S,L:A=A+L
50 POKE A,47,114,47,R/1000%10+48,R/100%10+48,R/10%10+48,R%10+48,47,64+P+I*(3-2*P),0:NEXT
60 FOR I=0 TO 8:[I]=0:NEXT:N=0:T=1
100 CLS:?"ROOM";R;" YOU:";CHR$(70+9*P)
110 FOR I=0 TO 8:LOCATE I%3*2+2,I/3*2+2:C=49+I:IF [I] C=70+9*[I]
120 ?CHR$(C);:NEXT
130 D="012345678036147258048246":W=0
140 FOR K=0 TO 21 STEP 3:A=[PEEK(D+K)-48]:IF A IF A=[PEEK(D+K+1)-48] IF A=[PEEK(D+K+2)-48] W=A
150 NEXT:LOCATE 0,8
160 IF W ?CHR$(70+9*W);" WIN!":END
170 IF N=9 ?"DRAW":END
180 IF T=P GOTO 300
200 ?"WAIT..."
210 NET GET #1800,#1200,16
220 IF NET()<0 GOTO 220
230 IF NET()<1 WAIT 30:GOTO 210
240 K=PEEK(#1200)-49:GOTO 400
300 ?"YOUR TURN (1-9)"
310 K=INKEY()-49:IF K<0 OR K>8 GOTO 310
320 IF [K] GOTO 310
330 POKE #1210,K+49,0:POST #1880,#1210,#1200,0
400 [K]=T:N=N+1:T=3-T:GOTO 100
